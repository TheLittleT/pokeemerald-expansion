raw `
Route1_Frlg_MapScripts::
	.byte 0

Route1_EventScript_MartClerk::
	lock
	faceplayer
	goto_if_set FLAG_GOT_POTION_ON_ROUTE_1, Route1_EventScript_AlreadyGotPotion
	msgbox Route1_Text_WorkAtPokeMartTakeSample
	textcolor NPC_TEXT_COLOR_NEUTRAL
	checkitemspace ITEM_POTION
	goto_if_eq VAR_RESULT, FALSE, EventScript_BagIsFull
	bufferitemname STR_VAR_2, ITEM_POTION
	playfanfare MUS_LEVEL_UP
	message gText_ObtainedTheItem
	waitmessage
	waitfanfare
	additem ITEM_POTION
	msgbox Route1_Text_PutPotionAway
	call EventScript_RestorePrevTextColor
	setflag FLAG_GOT_POTION_ON_ROUTE_1
	release
	end

Route1_EventScript_AlreadyGotPotion::
	msgbox Route1_Text_ComeSeeUsIfYouNeedPokeBalls
	release
	end

Route1_EventScript_Boy::
	msgbox Route1_Text_CanJumpFromLedges, MSGBOX_NPC
	end

Route1_EventScript_RouteSign::
	msgbox Route1_Text_RouteSign, MSGBOX_SIGN
	end

Route1_Text_WorkAtPokeMartTakeSample::
	.string "Hi!\n"
	.string "I work at a POKéMON MART.\p"
	.string "It's part of a convenient chain\n"
	.string "selling all sorts of items.\p"
	.string "Please, visit us in VIRIDIAN CITY.\p"
	.string "I know, I'll give you a sample.\n"
	.string "Here you go!$"

Route1_Text_ComeSeeUsIfYouNeedPokeBalls::
	.string "Please come see us if you need\n"
	.string "POKé BALLS for catching POKéMON.$"

Route1_Text_PutPotionAway::
	.string "{PLAYER} put the POTION away in\n"
	.string "the BAG's ITEMS POCKET.$"

Route1_Text_CanJumpFromLedges::
	.string "See those ledges along the road?\p"
	.string "It's a bit scary, but you can jump\n"
	.string "from them.\p"
	.string "You can get back to PALLET TOWN\n"
	.string "quicker that way.$"

Route1_Text_RouteSign::
	.string "ROUTE 1\n"
	.string "PALLET TOWN - VIRIDIAN CITY$"

`
text Route1_Text_JoeyIntro{
	"My Rattata is different from regular\n"
	"Rattata. It’s like my Rattata is in the\p"
	"top percentage of all Rattata.$"
}
text Route1_Text_JoeyDefeat{
	"Oh... looks like I need to train more.$"
}
text Route1_Text_JoeyPostBattle{
	"Next time you'll see me, me and my\n"
	" Rattata will be much stronger.$"
}
script Route1_EventScript_JoeyBattle {
	trainerbattle_single(TRAINER_YOUNGSTER_JOEY, Route1_Text_JoeyIntro, Route1_Text_JoeyDefeat)
	msgbox(Route1_Text_JoeyPostBattle, MSGBOX_AUTOCLOSE)
	waitmessage
	end
}

text Route1_Text_SallyIntro{
	"Look at this cute bird Pokemon I caught\p"
	"Huh, Battle?$"
}
text Route1_Text_SallyDefeat{
	"Didn't expect a battle this soon after\n"
	"catching a Pokemon.\p"
	"Huh, give money?$"
}
text Route1_Text_SallyPostBattle{
	"I'm never battling again.$"
}
script Route1_EventScript_SallyBattle {
	trainerbattle_single(TRAINER_LASS_SALLY, Route1_Text_SallyIntro, Route1_Text_SallyDefeat)
	msgbox(Route1_Text_SallyPostBattle, MSGBOX_AUTOCLOSE)
	waitmessage
	end
}

text Route1_Text_KevinIntro{
	"You can't beat me, I have 2 Pokemon!$"
}
text Route1_Text_KevinDefeat{
	"You beat me...$"
}
text Route1_Text_KevinPostBattle{
	"Looks I need to catch more Pokemon\p"
	"Then I'll be unstoppable!$"
}
script Route1_EventScript_KevinBattle {
	trainerbattle_single(TRAINER_CAMPER_KEVIN, Route1_Text_KevinIntro, Route1_Text_KevinDefeat)
	msgbox(Route1_Text_KevinPostBattle, MSGBOX_AUTOCLOSE)
	waitmessage
	end
}
text Route1_Text_JamesIntro{
	"I love to fish, don't you too?$"
}
text Route1_Text_JamesDefeat{
	"I expected a little bit more\n"
	"struggle...$"
}
text Route1_Text_JamesPostBattle{
	"When your Pokemon runs out of PP\p"
	"They struggle.$"
}
script Route1_EventScript_JamesBattle {
	trainerbattle_single(TRAINER_FISHERMAN_JAMES, Route1_Text_JamesIntro, Route1_Text_JamesDefeat)
	msgbox(Route1_Text_JamesPostBattle, MSGBOX_AUTOCLOSE)
	waitmessage
	end
}
text Route1_Text_SalIntro{
	"Fairy Pokemon are my favorite!$"
}
text Route1_Text_SalDefeat{
	"Audino isn't fairy type?$\n"
}
text Route1_Text_SalPostBattle{
	"I heard that it can become a fairy\p"
	"Maybe through evolution?$"
}
script Route1_EventScript_SalBattle {
	trainerbattle_single(TRAINER_LASS_SAL, Route1_Text_SalIntro, Route1_Text_SalDefeat)
	msgbox(Route1_Text_SalPostBattle, MSGBOX_AUTOCLOSE)
	waitmessage
	end
}